# ==========================================
# CO-LAB CONNECT - Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit your actual .env file to Git!
# ==========================================

# Core Application Security
SECRET_KEY=your-super-secret-flask-key-here
JWT_SECRET_KEY=your-super-secret-jwt-key-here
DEMO_PASSWORD=choose-a-local-only-demo-password
FLASK_ENV=development

# Database Connections
# Default local database fallback
DATABASE_URL=sqlite:///collabconnect.db
ALLOW_SQLITE_FALLBACK=true

# Production Supabase PostgreSQL Connection String
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Production Neon Database Connection String (optional fallback)
NEON_DATABASE_URL=

# AI Assistant (OpenCode Zen model, backend only - NEVER expose to frontend)
# Get a key at https://opencode.ai/auth ; leave blank to use built-in rules.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=big-pickle
OPENCODE_ZEN_URL=https://opencode.ai/zen/v1/chat/completions

# External API Credentials (Backend Only - NEVER expose to frontend)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_keep_private
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEON_API_KEY=your_neon_api_key_here

# Payment & Notification Settings
PAYMENT_MODE=sandbox
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
